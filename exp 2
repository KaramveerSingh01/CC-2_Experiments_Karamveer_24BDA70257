class Solution { public: vector productExceptSelf(vector& nums) { int n = nums.size(); vector answer(n, 1);
int prefix = 1;
for (int i = 0; i < n; i++) {
    answer[i] = prefix;
    prefix *= nums[i];
}

int suffix = 1;
for (int i = n - 1; i >= 0; i--) {
    answer[i] *= suffix;
    suffix *= nums[i];
}

return answer;

} };
